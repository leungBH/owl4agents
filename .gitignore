# Local AI/IDE tool state
.claude/
.codex/
.trae/
openspec/
backup/

# Internal-only documentation (retrospectives, deployment guides with internal IPs)
docs/retrospectives/
docs/internal/
docs/version.md

# Local-only evidence and scratch space
temp/
local/
local-traces/

# Generated example outputs (runtime logs, transcripts, screenshots)
temp/examples/

# Private or sensitive ontology inputs
test/owl_files/
test/reports/
test/corpus/realworld-local/
test/corpus/downloads/
test/corpus/large/
test/corpus/benchmarks/ore/
test/corpus/v086-repro/

# Large ontology files that exceed GitHub's 100MB file size limit
# Git LFS is configured (.gitattributes) but LFS upload requires HTTPS
# which is blocked in some environments. Download manually from:
#   hp.owl:    https://github.com/obophenotype/human-phenotype-ontology/releases
#   mondo.owl: https://github.com/monarch-initiative/mondo/releases
test/corpus/v089-full-suite/ontologies/hp.owl
test/corpus/v089-full-suite/ontologies/mondo.owl

# Gradle
.gradle/
.gradle-local/
build/
*.zip
# Do NOT ignore gradlew / gradlew.bat — they are required for reproducible builds
# Do NOT ignore gradle-wrapper.jar — it must be committed for wrapper to work

# IDE
.idea/
*.iml
.vscode/settings.json

# Java
*.class
*.war
*.hprof
# Maven metadata extracted by OWL API / Jena dependency resolution
META-INF/
/org/

# OS
.DS_Store
Thumbs.db

# owl4agents local workspace (created at runtime)
.owl4agents/
/workspaces/
/data/
/results/
/config.yaml

# v0.9.1 write-tools-expansion: version snapshots and audit logs
# (defense-in-depth even when the parent workspace dir is already ignored)
ontologies/*/versions/*.owx
ontologies/*/versions/versions.json
ontologies/*/audit.jsonl
ontologies/*/audit.*.jsonl

# Smoke test temporary workspaces
*-smoke/
v*-smoke-*/

# Timestamped final workspace directories
v*-final-*/

# Numeric scratch files at root
/[0-9]*/

# Root-level test artifacts, debug logs, and one-off scripts (v0.8+)
# These are local-only transient files generated during testing.
# Real acceptance evidence is in test/reports/acceptance/ (which is itself gitignored).
# Real regression tests are in modules/*/src/test/ and test/contracts/.
/*.log
/NUL
/hdr.txt
/post_hdr.txt
/q.json
/req_*.json
/trae_*.json
/trae_*.err
/trae_*.out
/trae_*.log
/trae_stream.log
/server.err
/server.out
/server_v3.log
/sse_a.log
/sse_b.log
/test_all_tools*.ps1
/test_run*.log
/test_junit.log
/test_scoreboard*.txt
/deploy_*.ps1
/deploy_*.log
/deploy.log
/import_*.log

# Sensitive files
*.pem
*.key
*.p12
watchdog-*.ps1

# Temporary extraction directories
/temp_jar_check/


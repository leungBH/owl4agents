<?xml version="1.0"?>
<rdf:RDF xmlns="http://owl4agents.org/test/exact-consistency/data-property-facet-conflict#"
     xml:base="http://owl4agents.org/test/exact-consistency/data-property-facet-conflict"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#">
    <owl:Ontology rdf:about="http://owl4agents.org/test/exact-consistency/data-property-facet-conflict"/>
    <owl:DatatypeProperty rdf:about="http://owl4agents.org/test/exact-consistency/data-property-facet-conflict#r">
        <rdfs:range>
            <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                <owl:withRestrictions rdf:parseType="Collection">
                    <rdf:Description>
                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</xsd:minInclusive>
                    </rdf:Description>
                </owl:withRestrictions>
            </rdfs:Datatype>
        </rdfs:range>
    </owl:DatatypeProperty>
    <owl:NamedIndividual rdf:about="http://owl4agents.org/test/exact-consistency/data-property-facet-conflict#a"/>
</rdf:RDF>

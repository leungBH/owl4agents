<?xml version="1.0"?>
<rdf:RDF xmlns="http://owl4agents.org/test/exact-consistency/negative-prop-assertion#"
     xml:base="http://owl4agents.org/test/exact-consistency/negative-prop-assertion"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#">
    <owl:Ontology rdf:about="http://owl4agents.org/test/exact-consistency/negative-prop-assertion"/>
    <owl:ObjectProperty rdf:about="http://owl4agents.org/test/exact-consistency/negative-prop-assertion#r"/>
    <owl:NamedIndividual rdf:about="http://owl4agents.org/test/exact-consistency/negative-prop-assertion#a"/>
    <owl:NamedIndividual rdf:about="http://owl4agents.org/test/exact-consistency/negative-prop-assertion#b"/>
    <owl:NegativeObjectPropertyAssertion>
        <owl:sourceIndividual rdf:resource="http://owl4agents.org/test/exact-consistency/negative-prop-assertion#a"/>
        <owl:assertionProperty rdf:resource="http://owl4agents.org/test/exact-consistency/negative-prop-assertion#r"/>
        <owl:targetIndividual rdf:resource="http://owl4agents.org/test/exact-consistency/negative-prop-assertion#b"/>
    </owl:NegativeObjectPropertyAssertion>
</rdf:RDF>
